-- ============================================================
-- Recipe 127 (procedure): deterministic PII compliance check
--
-- No LLM call. Takes a PII map (JSON) and a destination, derives
-- Boolean facts, and checks them against the rules with the chosen
-- engine (stdlib | sympy | z3). Returns the verdict as JSON:
--   {"status", "engine", "compliant", "violated": [...], "facts": {...}}
--
-- Used by pii_compliance.spl, and by GraphLang as a `procedure_ref`
-- (graflang/cookbook/compliance_audit).
--
-- Run:
--   spl3 run cookbook-solver/127_pii_compliance/compliance_check.spl \
--       --adapter echo \
--       --param 'pii_map={"entities":[{"type":"SSN","masked":false}]}' \
--       --param destination=external_api --param engine=stdlib
--
-- Your own rules: --param rules_file=path/to/rules.json   (default: rules.json next to this file)
-- ============================================================

WORKFLOW compliance_check
  INPUT @pii_map TEXT := '{"entities": []}'
  INPUT @destination TEXT := "external_api"
  INPUT @engine TEXT := "stdlib"
  INPUT @rules_file TEXT := ""
  OUTPUT @verdict TEXT
DO
  CALL normalize_engine(@engine) INTO @engine;
  CALL load_rules(@rules_file) INTO @rules;
  CALL check_compliance(@pii_map, @destination, @engine, @rules) INTO @verdict;
  ASSERT check_succeeded(@verdict);
  RETURN @verdict WITH status = "complete";
END;
