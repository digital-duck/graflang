-- generated by `graf compile --lang spl`
-- tools used (@spl_tool): shout

CREATE TOOL_API shout(text TEXT, suffix TEXT)
RETURNS TEXT AS PYTHON $$
def shout(text: str, suffix: str) -> str:
    return text.strip().upper() + suffix
$$;

WORKFLOW w
  INPUT:
    @word TEXT := 'hi'
  OUTPUT: @loud TEXT
DO
  CALL shout(@word, '!') INTO @loud
  RETURN @loud
END
